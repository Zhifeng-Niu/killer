# Killer Agent Configuration
# ─────────────────────────────
# 复制此文件为 .env 并填入你的 API Key:
#   cp .env.example .env
#
# 或运行交互式配置向导:
#   killer-app --init
#
# 提示: 只需设置一个 API Key 即可。系统会自动识别服务商。

# === LLM Provider ===
# 可选: deepseek, glm, minimax, qwen, moonshot, siliconflow, baichuan, yi
#       anthropic, openai, openrouter, gemini, openai-compatible
# 如果不设置，系统会根据你的 API Key 自动识别
KILLER_LLM_PROVIDER=deepseek

# === API Keys（只需设置一个）===
DEEPSEEK_API_KEY=your-deepseek-key
# GLM_API_KEY=your-glm-key
# MINIMAX_API_KEY=your-minimax-key
# DASHSCOPE_API_KEY=your-qwen-key
# MOONSHOT_API_KEY=your-moonshot-key
# SILICONFLOW_API_KEY=your-siliconflow-key
# BAICHUAN_API_KEY=your-baichuan-key
# YI_API_KEY=your-yi-key
# ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key
# OPENROUTER_API_KEY=your-openrouter-key
# GOOGLE_API_KEY=your-gemini-key

# === 可选 ===
# KILLER_MODEL=deepseek-chat          # 模型覆盖
# KILLER_BASE_URL=https://...         # 自定义 API 端点（支持任意 OpenAI 兼容服务商）
# KILLER_DEBUG=true                   # 调试日志
# KILLER_LOG_LEVEL=info               # 日志级别: debug, info, warn, error, silent

# === 高级：自定义 OpenAI 兼容服务商 ===
# 如果你的服务商不在预设列表中，可以用通用模式接入：
# KILLER_LLM_PROVIDER=openai-compatible
# KILLER_BASE_URL=https://your-provider.com/v1/chat/completions
# KILLER_API_KEY=your-key
# KILLER_MODEL=model-name
